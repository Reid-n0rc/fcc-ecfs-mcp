{
  "name": "fcc-ecfs",
  "displayName": "FCC ECFS Tools",
  "description": "MCP server and slash commands for the FCC's Electronic Comment Filing System (ECFS) public API",
  "version": "0.4.1",
  "author": {
    "name": "Reid Crowe"
  },
  "license": "MIT",
  "mcpServers": {
    "fcc-ecfs": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/index.js"],
      "env": {
        "ECFS_API_KEY": "${user_config.ecfs_api_key}",
        "ECFS_DOWNLOAD_DIR": "${user_config.download_dir}"
      }
    }
  },
  "userConfig": {
    "ecfs_api_key": {
      "type": "string",
      "title": "FCC ECFS API Key",
      "description": "Free API key from https://www.fcc.gov/ecfs/help/public_api",
      "sensitive": true,
      "required": true
    },
    "download_dir": {
      "type": "string",
      "title": "Download folder",
      "description": "Folder ecfs_download_document saves into; downloads can't go outside it. Defaults to ~/Downloads/ecfs.",
      "default": "~/Downloads/ecfs",
      "required": false
    }
  }
}
